# Origin của frontend được phép gọi API (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Model YOLO pretrained sẽ được tải và load một lần lúc startup
# Các biến thể khác: yolo11s.pt (lớn hơn, chính xác hơn), yolo11m.pt, yolo11l.pt, yolo11x.pt
YOLO_MODEL=yolo11n.pt

# Thư mục lưu ảnh/video tạm và file đã annotate
OUTPUT_DIR=outputs
